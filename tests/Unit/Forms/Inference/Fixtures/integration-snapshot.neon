parameters:
	customRulesetUsed: true
	netteFormContainerValuesDynamicReturnType: false
	bootstrapFiles:
		- ../../../../../tests/autoload.php
	scanFiles:
		- ../../../../Doubles/Forms/functions.php
	orisai:
		nette:
			forms:
				defaultContainerClass: Tests\OriPhpstan\Nette\Doubles\Forms\Form\FormContainer
	# nette/forms 3.2 deprecates the validator constants the corpus uses; not an inference finding.
	ignoreErrors:
		-
			identifier: classConstant.deprecated
			reportUnmatched: false

includes:
	- ../../../../../extension.neon
