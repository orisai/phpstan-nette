	initializationProbe: Tests\OriPhpstan\Nette\Unit\Dic\Fixtures\App\InitializationProbeExtension

parameters:
	stringParam: beta-secret-value
	intParam: 43
	floatParam: 2.71
	boolParam: false
	nullParam: null
	listParam: [4, 5]
	emptyParam: []
	mixedTypeParam: now-a-string
	nested:
		shared: world
	betaOnlyParam: only-in-beta

services:
	foo: Tests\OriPhpstan\Nette\Unit\Dic\Fixtures\App\FooServiceBeta
	bar.baz: Tests\OriPhpstan\Nette\Unit\Dic\Fixtures\App\BarService(@06)
	'06': Tests\OriPhpstan\Nette\Unit\Dic\Fixtures\App\FooService
	sharedName: Tests\OriPhpstan\Nette\Unit\Dic\Fixtures\App\BetaVariant
	betaOnly: Tests\OriPhpstan\Nette\Unit\Dic\Fixtures\App\BetaOnlyService
