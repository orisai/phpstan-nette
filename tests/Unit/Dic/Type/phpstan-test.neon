includes:
	- ../../../../%env.COMPOSER_VENDOR_DIR%/phpstan/phpstan-nette/extension.neon
	- ../../../../extension.neon

expandRelativePaths:
	- '[parameters][orisai][nette][dic][containerLoader]'

parameters:
	customRulesetUsed: true
	orisai:
		nette:
			dic:
				containerLoader: ../Fixtures/fixture-container-loader.php
	netteComponentModelDynamicReturnType: false
	netteFormContainerValuesDynamicReturnType: false
	netteServiceLocatorDynamicReturnType: false
