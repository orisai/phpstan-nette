<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:noNamespaceSchemaLocation="./../vendor/phpunit/phpunit/phpunit.xsd"
		 bootstrap="../tests/bootstrap.php"
		 defaultTestSuite="all"
		 beStrictAboutOutputDuringTests="true"
		 cacheResultFile="../var/tools/PHPUnit/results.dat"
		 colors="true"
		 failOnRisky="true"
		 failOnWarning="true"
		 stderr="true"
		 verbose="true"
>
	<testsuites>
		<testsuite name="unit">
			<directory>../tests/Unit</directory>
			<!-- Upstream-shaped .phpt corpus fixtures, not PHPT tests. -->
			<exclude>../tests/Unit/Tools/Fixtures</exclude>
		</testsuite>
		<testsuite name="integration">
			<directory>../tests/Integration</directory>
		</testsuite>
		<testsuite name="all">
			<directory>../tests</directory>
			<exclude>../tests/Unit/Tools/Fixtures</exclude>
		</testsuite>
	</testsuites>

	<coverage cacheDirectory="../var/tools/PHPUnit/coverage" processUncoveredFiles="false">
		<include>
			<directory suffix=".php">../src</directory>
		</include>
	</coverage>
</phpunit>
