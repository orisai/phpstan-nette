includes:
	- phpstan.common.neon
	- phpstan.baseline.neon

# Primary: the newest dependency set (Latte 3.1), analysed for the highest supported PHP.
parameters:
	phpVersion: 80400

	# Latte-2-only code is analysed against Latte 2 by phpstan.latte2.neon.
	excludePaths:
		analyse:
			- ../src/Latte/Version/Latte2
			- ../tests/*/Latte2/*

	ignoreErrors:
		# Invoked by reflection from LatteVersionAdapterFactory.
		-
			identifier: shipmonk.deadMethod
			message: '#^Unused OriPhpstan\\Nette\\Latte\\Version\\Latte3\\Latte3EngineReader::create$#'
			path: ../src/Latte/Version/Latte3/Latte3EngineReader.php
		# Latte\Compiler\Block is @internal for its construction, yet it is the public payload of
		# BlockNode::$block, DefineNode::$block, SnippetNode::$block and SnippetAreaNode::$block; the
		# node facts read its name, dynamic-ness and parameters exactly as Latte's own passes do.
		-
			message: '#Latte\\Compiler\\Block#'
			identifier: parameter.internalClass
			path: ../src/Latte/Version/Latte3/*
		-
			message: '#internal class Latte\\Compiler\\Block#'
			identifier: property.internalClass
			path: ../src/Latte/Version/Latte3/*
		-
			message: '#internal class Latte\\Compiler\\Block#'
			identifier: method.internalClass
			path: ../src/Latte/Version/Latte3/*
		# Latte ships no public accessor for its filter loaders; the reader asks the executor as the runtime does.
		-
			identifiers: [instanceof.internalClass, classConstant.internalClass, method.internalClass]
			message: '#internal class Latte\\Runtime\\FilterExecutor#'
			path: ../src/Latte/Version/Latte3/Latte3EngineReader.php
		# The Latte 3.1-only feature the scoped-foreach fixture enables; the latte30 profile analyses it too.
		-
			identifier: classConstant.notFound
			message: '#^Access to undefined constant Latte\\Feature::ScopedLoopVariables\.$#'
			path: ../tests/Unit/Latte/Customs/Latte3/Fixtures/engine-loader-scoped-loops.php
			reportUnmatched: false
		# Deprecated by Latte 3.1 and nette/forms 3.3 only; the latte30 profile analyses these files too.
		-
			identifier: classConstant.deprecated
			message: '#^Fetching deprecated class constant CONTENT_TEXT of class Latte\\Engine:#'
			path: ../tests/Integration/Latte/RuntimeParity/RuntimeParityTest.php
		-
			identifier: classConstant.deprecatedClass
			message: '#^Access to constant on deprecated class Nette\\Forms\\Controls\\CsrfProtection:#'
			paths:
				- ../tests/Unit/Forms/CatalogTest.php
				- ../tests/Unit/LatteForms/MacroSuitabilityTest.php
			reportUnmatched: false
