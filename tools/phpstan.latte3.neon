includes:
	- phpstan.neon
	- phpstan.latte3.baseline.neon

parameters:
	# nette/application 3.2+ (the floor of every Latte 3 profile) uses readonly properties; a lower
	# minimum makes PHPStan's parser reject those vendor files, which then read as missing classes.
	phpVersion:
		min: 80100
		max: 80400
	resultCachePath: %currentWorkingDirectory%/var/tools/PHPStan/resultCache.latte3.php

	# Only the version seam and the Latte-3-only test code (tests/**/Latte3/) are analysed against
	# Latte 3; the Latte 2 adapter and everything built on Latte 2 internals is covered by phpstan.neon.
	paths:
		- ../src/Latte/Version
		- ../tests/Integration/Latte/Latte3
		- ../tests/Toolkit/Latte3
		- ../tests/Unit/Latte/Customs/Latte3
		- ../tests/Unit/Latte/Version/Latte3
	excludePaths!:
		analyse:
			- ../src/Latte/Version/Latte2
		analyseAndScan:
			- ../tests/Unit/Latte/Customs/Latte3/Fixtures/__snapshots__

	# Partial analysis: usages and ignored errors outside the seam are not visible here.
	reportUnmatchedIgnoredErrors: false
	shipmonkDeadCode:
		detect:
			deadMethods: false
			deadConstants: false
			deadEnumCases: false
			deadProperties:
				neverRead: false
				neverWritten: false

	ignoreErrors:
		# Latte ships no public accessor for its filter loaders; the reader asks the executor as the runtime does.
		-
			identifiers: [instanceof.internalClass, classConstant.internalClass, method.internalClass]
			message: '#internal class Latte\\Runtime\\FilterExecutor#'
			path: ../src/Latte/Version/Latte3/Latte3EngineReader.php
		# The Latte 3.1-only feature the scoped-foreach fixture enables; the 3.0 profile analyses it too.
		-
			identifier: classConstant.notFound
			message: '#^Access to undefined constant Latte\\Feature::ScopedLoopVariables\.$#'
			path: ../tests/Unit/Latte/Customs/Latte3/Fixtures/engine-loader-scoped-loops.php
