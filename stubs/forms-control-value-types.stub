/**
 * A plain button stays in getValues(): the button that submitted the form holds its caption
 * (rendered as the value attribute, a string), every other button is null. SubmitButton /
 * ImageButton set omitted on themselves and never reach this catalog entry.
 *
 * @form-read-type string|null
 */
class Button
{
}
