includes:
	- config/forms.neon
	- config/component.neon
	- config/dic.neon
	- config/latte.neon
	- config/latteForms.neon

parametersSchema:
	orisaiNette: structure([
		forms: structure([
			enabled: bool()
			defaultContainerClass: string()
			reportUnannotatedRegistrars: bool()
			catalogs: listOf(string())
			internals: structure([
				indexShadowCompare: bool()
			])
		])
		component: structure([
			enabled: bool()
		])
		latte: structure([
			enabled: bool()
			narrowing: structure([
				enabled: bool()
				storePath: string()
			])
			discovery: structure([
				enabled: bool()
				storePath: string()
				coarseInvalidationAccepted: bool()
				formulas: arrayOf(anyOf(string(), arrayOf(string(), string())), string())
			])
			engineLoader: schema(string(), nullable())
			templateFactoryContainerLoader: schema(string(), nullable())
			firstPartyPaths: listOf(string())
			templateTypeRequired: bool()
			includeIsolation: bool()
			allowNarrowingOverride: bool()
			reportWrongPhpDocTypeInVarType: bool()
			reportAnyTypeWideningInVarType: bool()
		])
		dic: structure([
			containerLoader: schema(string(), nullable())
		])
	])

services:
	orisaiNette.configurationGuard:
		class: OriPhpstan\Nette\Configuration\ConfigurationGuard
		arguments:
			orisaiNette: %orisaiNette%
			fileExtensions: %fileExtensions%
		autowired: false

	-
		class: OriPhpstan\Nette\Configuration\ConfigurationGuardRule
		arguments:
			guard: @orisaiNette.configurationGuard
		tags: [phpstan.rules.rule]
