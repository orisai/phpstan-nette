{
	"name": "orisai/phpstan-nette",
	"description": "PHPStan understands Nette DI containers, Nette Forms, Latte templates and how they connect",
	"keywords": [
		"orisai",
		"phpstan",
		"nette",
		"latte",
		"forms",
		"static analysis"
	],
	"type": "phpstan-extension",
	"license": "MPL-2.0",
	"homepage": "https://github.com/orisai/phpstan-nette",
	"authors": [
		{
			"name": "Marek Bartoš",
			"homepage": "https://github.com/mabar"
		}
	],
	"require": {
		"php": "7.4 - 8.4",
		"phpstan/phpstan": "^2.0.0"
	},
	"require-dev": {
		"brianium/paratest": "^6.3.0",
		"cweagans/composer-patches": "^1.7.0",
		"infection/infection": "^0.26.0|^0.27.0|^0.28.0|^0.29.0",
		"kdyby/forms-replicator": "^2.0.0",
		"latte/latte": "~2.11.6",
		"nette/application": "^3.1.15",
		"nette/di": "^3.1.3",
		"nette/forms": "^3.1.11",
		"orisai/coding-standard": "^3.0.0",
		"phpstan/extension-installer": "^1.0.0",
		"phpstan/phpstan-deprecation-rules": "^2.0.0",
		"phpstan/phpstan-nette": "^2.0.0",
		"phpstan/phpstan-phpunit": "^2.0.0",
		"phpstan/phpstan-strict-rules": "^2.0.0",
		"phpunit/phpunit": "^9.5.0",
		"shipmonk/dead-code-detector": "^0.15.0",
		"staabm/annotate-pull-request-from-checkstyle": "^1.7.0"
	},
	"conflict": {
		"kdyby/forms-replicator": "<2.0.0",
		"latte/latte": "<2.11.6 || >=3.0.0",
		"nette/application": "<3.1.15",
		"nette/di": "<3.1.3",
		"nette/forms": "<3.1.11"
	},
	"suggest": {
		"kdyby/forms-replicator": "Typed replicator containers and rows",
		"latte/latte": "Latte template analysis (Latte 2.11 only)",
		"nette/application": "Presenter and control template discovery, UI form typing",
		"nette/di": "Container service typing",
		"nette/forms": "Form shape inference and control typing",
		"shipmonk/dead-code-detector": "Container service and template-only method usage detection"
	},
	"autoload": {
		"psr-4": {
			"OriPhpstan\\Nette\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\OriPhpstan\\Nette\\": "tests"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"cweagans/composer-patches": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"infection/extension-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"phpstan": {
			"includes": [
				"extension.neon"
			]
		},
		"patches": {
			"phpstan/phpstan-nette": {
				"Conditional dynamic return types (component model, form getValues())": "patches/phpstan-nette-conditional-dynamic-return-types.patch"
			}
		}
	}
}
